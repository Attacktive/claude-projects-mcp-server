# Copy to .env and fill in. NEVER commit .env — the session key is a live claude.ai account credential that can read every conversation and act as you.

# From claude.ai in a browser: DevTools -> Application -> Cookies -> sessionKey
# Starts with sk-ant-sid02- (older accounts show sid01-). Paste it bare, no quotes.
# It expires periodically; re-copy when a tool reports a 401.
CLAUDE_PROJECTS_SESSION_KEY=

# Where replaced and deleted document contents are kept before they are overwritten.
# Defaults to ~/.local/share/claude-projects-mcp/trash
CLAUDE_PROJECTS_BACKUP_DIRECTORY=
